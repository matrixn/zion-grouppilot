<Window
    x:Class="GroupPilot_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GroupPilot">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" RowDefinitions="48,*">
        <TitleBar x:Name="AppTitleBar" Title="GroupPilot"
                  IsPaneToggleButtonVisible="True" PaneToggleRequested="TogglePane">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Brand.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="234"
                        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        SelectionChanged="Navigate">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" />
                <NavigationViewItem Content="Post Library" Tag="Library" Icon="Library" />
                <NavigationViewItem Content="Post Composer" Tag="Composer" Icon="Edit" />
                <NavigationViewItem Content="Groups" Tag="Groups" Icon="People" />
                <NavigationViewItem Content="Campaigns" Tag="Campaigns" Icon="Flag" />
                <NavigationViewItem Content="Facebook Browser" Tag="Browser" Icon="World" />
                <NavigationViewItem Content="Publishing History" Tag="History" Icon="Clock" />
            </NavigationView.MenuItems>
            <Grid RowDefinitions="Auto,*">
                <InfoBar x:Name="Feedback" Margin="24,8,24,0" IsClosable="False" />
                <ContentControl x:Name="ContentHost" Grid.Row="1"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <ContentControl x:Name="FacebookHost" Grid.Row="1" Visibility="Collapsed"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
